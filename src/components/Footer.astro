---
import { site } from '../site';
---

<footer class="border-t border-ink/10">
  <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-10 text-sm text-muted sm:flex-row sm:justify-between sm:px-6">
    <p>
      © {new Date().getFullYear()} {site.name}. A fan site. Not official, and not linked to Cristiano Ronaldo or his clubs.
      <span class="km" lang="km">គេហទំព័ររបស់អ្នកគាំទ្រ។ មិនមែនជាគេហទំព័រផ្លូវការទេ។</span>
    </p>
    <p>
      Say hi! <span lang="km" class="font-khmer">ទាក់ទងមកយើង</span> <a href={`mailto:${site.contactEmail}`} class="font-medium text-ink underline underline-offset-4 hover:text-brand">{site.contactEmail}</a>
    </p>
  </div>
</footer>
