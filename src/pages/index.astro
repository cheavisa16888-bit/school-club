---
// The homepage. Each <section> below is one band of the page — ask the AI to
// add, remove, or reorder them. Every `km` field / class="km" line is the Khmer
// caption shown under the English.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site';

const stats = [
  { value: '900+', label: 'official career goals', labelKm: 'គ្រាប់បាល់ផ្លូវការក្នុងអាជីព' },
  { value: '5', label: 'Ballon d’Or awards', labelKm: 'ពានរង្វាន់ Ballon d’Or' },
  { value: '5', label: 'Champions League titles', labelKm: 'ពាន Champions League' },
  { value: '200+', label: 'games for Portugal', labelKm: 'ប្រកួតឱ្យព័រទុយហ្គាល់' },
];

const clubs = [
  {
    years: '2002–2003',
    name: 'Sporting CP',
    place: 'Lisbon, Portugal',
    text: 'His first professional club. He played his first senior games here at 17.',
    textKm: 'ក្លឹបអាជីពដំបូងរបស់គាត់។ គាត់លេងប្រកួតដំបូងនៅទីនេះ ពេលអាយុ ១៧ ឆ្នាំ។',
  },
  {
    years: '2003–2009',
    name: 'Manchester United',
    place: 'England',
    text: 'He became a star, won the Premier League three times, and won his first Champions League and Ballon d’Or.',
    textKm: 'គាត់ក្លាយជាតារា ឈ្នះ Premier League បីដង និងឈ្នះ Champions League និង Ballon d’Or ជាលើកដំបូង។',
  },
  {
    years: '2009–2018',
    name: 'Real Madrid',
    place: 'Spain',
    text: 'The club’s all-time top scorer, with 450 goals and four Champions League titles.',
    textKm: 'អ្នកស៊ុតបញ្ចូលទីច្រើនជាងគេបំផុតរបស់ក្លឹប ជាមួយ ៤៥០ គ្រាប់ និងពាន Champions League បួនដង។',
  },
  {
    years: '2018–2021',
    name: 'Juventus',
    place: 'Italy',
    text: 'He won Serie A twice and was the league’s top scorer.',
    textKm: 'គាត់ឈ្នះ Serie A ពីរដង ហើយជាអ្នកស៊ុតបញ្ចូលទីច្រើនជាងគេក្នុងលីគ។',
  },
  {
    years: '2021–2022',
    name: 'Manchester United',
    place: 'England',
    text: 'A short return to the club where he first became famous.',
    textKm: 'ការត្រឡប់មកវិញមួយរយៈខ្លី ទៅក្លឹបដែលធ្វើឱ្យគាត់ល្បីល្បាញដំបូង។',
  },
  {
    years: '2023–now',
    name: 'Al Nassr',
    place: 'Saudi Arabia',
    text: 'Still scoring goals and still the captain of Portugal.',
    textKm: 'នៅតែស៊ុតបញ្ចូលទី ហើយនៅតែជាប្រធានក្រុមព័រទុយហ្គាល់។',
  },
];

const trophies = [
  { icon: '🏆', title: 'Euro 2016', titleKm: 'ពាន Euro 2016', text: 'Portugal’s first big international trophy.', textKm: 'ពានធំអន្តរជាតិដំបូងរបស់ព័រទុយហ្គាល់។' },
  { icon: '⭐', title: '5 × Champions League', titleKm: 'Champions League ៥ ដង', text: 'One with Manchester United, four with Real Madrid.', textKm: 'មួយជាមួយ Manchester United បួនជាមួយ Real Madrid។' },
  { icon: '🥇', title: '5 × Ballon d’Or', titleKm: 'Ballon d’Or ៥ ដង', text: 'The prize for the best player in the world: 2008, 2013, 2014, 2016, 2017.', textKm: 'ពានសម្រាប់កីឡាករល្អបំផុតលើពិភពលោក៖ ២០០៨ ២០១៣ ២០១៤ ២០១៦ ២០១៧។' },
  { icon: '🇵🇹', title: '2 × Nations League', titleKm: 'Nations League ២ ដង', text: 'Won with Portugal in 2019 and 2025.', textKm: 'ឈ្នះជាមួយព័រទុយហ្គាល់ ក្នុងឆ្នាំ ២០១៩ និង ២០២៥។' },
];

const lessons = [
  {
    icon: '💪',
    title: 'Work hard every day',
    titleKm: 'ខិតខំរាល់ថ្ងៃ',
    text: 'He is famous for training longer than everyone else, and for looking after his body.',
    textKm: 'គាត់ល្បីថាហ្វឹកហាត់យូរជាងគេ ហើយថែរក្សារាងកាយរបស់គាត់យ៉ាងល្អ។',
  },
  {
    icon: '🌱',
    title: 'Start small, dream big',
    titleKm: 'ចាប់ផ្តើមតូច សុបិនធំ',
    text: 'He grew up in a poor family on Madeira, a small island. Now the whole world knows his name.',
    textKm: 'គាត់ធំឡើងក្នុងគ្រួសារក្រីក្រ នៅលើកោះតូចមួយឈ្មោះ Madeira។ ឥឡូវ ពិភពលោកទាំងមូលស្គាល់ឈ្មោះគាត់។',
  },
  {
    icon: '🔁',
    title: 'Never give up',
    titleKm: 'កុំបោះបង់',
    text: 'He keeps playing at the top level for more than 20 years, in four different countries.',
    textKm: 'គាត់បន្តលេងនៅកម្រិតខ្ពស់អស់រយៈពេលជាង ២០ ឆ្នាំ ក្នុងប្រទេសបួនផ្សេងគ្នា។',
  },
];
---

<Base>
  <Header />

  <main>
    <!-- HERO -->
    <section class="relative overflow-hidden">
      <div class="pointer-events-none absolute -top-40 -right-40 size-[36rem] rounded-full bg-sun/25 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-40 -left-40 size-[30rem] rounded-full bg-brand/15 blur-3xl"></div>

      <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 sm:px-6 sm:py-24 lg:grid-cols-2">
        <div>
          <p class="inline-flex items-center gap-2 rounded-full border border-ink/10 bg-white/70 px-3 py-1 text-sm font-medium">
            <span class="size-2 rounded-full bg-leaf"></span>
            A fan site from Cambodia ⚽
          </p>
          <h1 class="mt-6 font-display text-5xl leading-[1.02] font-extrabold tracking-tight text-balance sm:text-6xl lg:text-7xl">
            Cristiano <span class="text-brand">Ronaldo</span>. The legend of number 7.
          </h1>
          <p lang="km" class="mt-4 text-xl text-ink/70">គ្រីស្ទីយ៉ាណូ រ៉ូណាល់ដូ — តារាលេខ ៧</p>
          <p class="mt-6 max-w-xl text-lg text-muted">
            From a small island in Portugal to the biggest stadiums in the world. Learn his story, his clubs, and his records.
            <span class="km" lang="km">ពីកោះតូចមួយក្នុងប្រទេសព័រទុយហ្គាល់ ទៅកាន់កីឡដ្ឋានធំៗបំផុតលើពិភពលោក។ ស្វែងយល់ពីរឿងរ៉ាវ ក្លឹប និងកំណត់ត្រារបស់គាត់។</span>
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#story" class="rounded-full bg-brand px-6 py-3 font-semibold text-paper shadow-lg shadow-brand/25 transition hover:bg-brand-dark">
              Read his story ↓ <span lang="km" class="font-khmer font-normal opacity-80">អានរឿងរ៉ាវ</span>
            </a>
            <a href="#join" class="rounded-full border border-ink/15 bg-white px-6 py-3 font-semibold transition hover:border-ink/40">
              Join the fans → <span lang="km" class="font-khmer font-normal opacity-60">ចូលរួម</span>
            </a>
          </div>
        </div>

        <!-- Illustration: a red number 7 shirt, drawn with CSS -->
        <div class="relative mx-auto w-64 sm:w-80" aria-hidden="true">
          <div class="relative">
            <div class="absolute top-0 -left-10 h-24 w-20 -rotate-[25deg] rounded-xl bg-brand-dark sm:-left-12 sm:h-28 sm:w-24"></div>
            <div class="absolute top-0 -right-10 h-24 w-20 rotate-[25deg] rounded-xl bg-brand-dark sm:-right-12 sm:h-28 sm:w-24"></div>
            <div class="relative rounded-t-[2rem] rounded-b-2xl bg-brand px-6 pt-10 pb-12 text-center shadow-2xl shadow-brand/30">
              <div class="absolute top-0 left-1/2 h-6 w-20 -translate-x-1/2 rounded-b-full bg-paper"></div>
              <p class="font-display text-2xl font-extrabold tracking-[0.3em] text-sun sm:text-3xl">RONALDO</p>
              <p class="font-display text-[8rem] leading-none font-extrabold text-sun sm:text-[10rem]">7</p>
              <div class="mx-auto mt-2 h-2 w-24 rounded-full bg-leaf"></div>
            </div>
          </div>
          <div class="absolute -right-4 -bottom-6 grid size-20 rotate-12 place-items-center rounded-full bg-white text-5xl shadow-xl">⚽</div>
        </div>
      </div>
    </section>

    <!-- STATS -->
    <section class="border-y border-ink/10 bg-white">
      <dl class="mx-auto grid max-w-6xl grid-cols-2 gap-8 px-4 py-10 sm:px-6 md:grid-cols-4">
        {
          stats.map((s) => (
            <div>
              <dt class="sr-only">{s.label}</dt>
              <dd class="font-display text-4xl font-extrabold text-brand">{s.value}</dd>
              <dd class="mt-1 text-sm text-muted">
                {s.label}
                <span class="km" lang="km">{s.labelKm}</span>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- STORY -->
    <section id="story" class="mx-auto grid max-w-6xl scroll-mt-20 gap-10 px-4 py-20 sm:px-6 sm:py-28 lg:grid-cols-[1fr_1.4fr]">
      <div>
        <p class="font-semibold text-brand">His story <span lang="km" class="font-khmer font-normal">· រឿងរ៉ាវរបស់គាត់</span></p>
        <h2 class="mt-2 font-display text-4xl font-extrabold tracking-tight text-balance sm:text-5xl">A boy from Madeira.</h2>
        <p class="km mt-3 text-xl font-semibold sm:text-2xl" lang="km">ក្មេងប្រុសម្នាក់មកពីកោះ Madeira។</p>
      </div>
      <div class="space-y-5 text-lg text-muted">
        <p>
          Cristiano Ronaldo was born on 5 February 1985 in Funchal, on the island of Madeira in Portugal. His family did not have much money. He played football in the street every day.
          <span class="km" lang="km">គ្រីស្ទីយ៉ាណូ រ៉ូណាល់ដូ កើតនៅថ្ងៃទី ៥ ខែកុម្ភៈ ឆ្នាំ ១៩៨៥ នៅទីក្រុង Funchal លើកោះ Madeira ប្រទេសព័រទុយហ្គាល់។ គ្រួសាររបស់គាត់មិនមានលុយច្រើនទេ។ គាត់លេងបាល់ទាត់តាមផ្លូវរាល់ថ្ងៃ។</span>
        </p>
        <p>
          At 12, he moved alone to Lisbon to train at Sporting CP. It was hard to live far from his family, but he kept going. At 18, he joined Manchester United, and the world started to know his name.
          <span class="km" lang="km">នៅអាយុ ១២ ឆ្នាំ គាត់ផ្លាស់ទៅទីក្រុង Lisbon តែម្នាក់ឯង ដើម្បីហ្វឹកហាត់នៅ Sporting CP។ ការរស់នៅឆ្ងាយពីគ្រួសារពិបាកណាស់ ប៉ុន្តែគាត់នៅតែបន្ត។ នៅអាយុ ១៨ ឆ្នាំ គាត់ចូលក្លឹប Manchester United ហើយពិភពលោកចាប់ផ្តើមស្គាល់ឈ្មោះគាត់។</span>
        </p>
        <p>
          Today he is the top goal scorer in the history of men’s international football, and one of the greatest players of all time.
          <span class="km" lang="km">សព្វថ្ងៃ គាត់ជាអ្នកស៊ុតបញ្ចូលទីច្រើនជាងគេបំផុត ក្នុងប្រវត្តិសាស្ត្របាល់ទាត់អន្តរជាតិបុរស និងជាកីឡាករល្អបំផុតម្នាក់គ្រប់ពេលវេលា។</span>
        </p>
      </div>
    </section>

    <!-- CLUBS -->
    <section id="clubs" class="scroll-mt-20 bg-white">
      <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
        <p class="font-semibold text-brand">Clubs <span lang="km" class="font-khmer font-normal">· ក្លឹប</span></p>
        <h2 class="mt-2 max-w-2xl font-display text-4xl font-extrabold tracking-tight text-balance sm:text-5xl">Five clubs, four countries.</h2>
        <p class="km mt-3 text-xl font-semibold sm:text-2xl" lang="km">ក្លឹបប្រាំ ប្រទេសបួន។</p>
        <ol class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            clubs.map((c) => (
              <li class="rounded-2xl border border-ink/10 bg-paper p-6">
                <span class="inline-block rounded-full bg-ink px-3 py-1 font-display text-sm font-bold text-paper">{c.years}</span>
                <h3 class="mt-4 font-display text-2xl font-bold">{c.name}</h3>
                <p class="text-sm font-medium text-leaf">{c.place}</p>
                <p class="mt-2 text-muted">
                  {c.text}
                  <span class="km" lang="km">{c.textKm}</span>
                </p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- BIG STATEMENT -->
    <section class="bg-ink text-paper">
      <div class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 sm:py-28">
        <p class="font-display text-6xl font-extrabold text-sun sm:text-8xl">SIUUU!</p>
        <p class="mt-6 font-display text-2xl leading-tight font-bold text-balance sm:text-4xl">
          His famous jump-and-shout goal celebration. Fans all over the world copy it, from Lisbon to Phnom Penh.
        </p>
        <p lang="km" class="km mt-6 text-xl sm:text-2xl">
          ការអបអរគ្រាប់បាល់ដ៏ល្បីរបស់គាត់ ដោយលោត ហើយស្រែក។ អ្នកគាំទ្រទូទាំងពិភពលោកធ្វើតាម ពី Lisbon ដល់ភ្នំពេញ។
        </p>
      </div>
    </section>

    <!-- TROPHIES -->
    <section id="trophies" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-20 sm:px-6 sm:py-28">
      <p class="font-semibold text-brand">Trophies <span lang="km" class="font-khmer font-normal">· ពានរង្វាន់</span></p>
      <h2 class="mt-2 font-display text-4xl font-extrabold tracking-tight sm:text-5xl">The biggest wins.</h2>
      <p class="km mt-3 text-xl font-semibold sm:text-2xl" lang="km">ជ័យជម្នះធំៗបំផុត។</p>
      <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          trophies.map((t) => (
            <li class="rounded-2xl border-t-4 border-sun bg-white p-6 shadow-sm">
              <span class="text-4xl">{t.icon}</span>
              <h3 class="mt-4 font-display text-xl font-bold">
                {t.title}
                <span class="km text-base" lang="km">{t.titleKm}</span>
              </h3>
              <p class="mt-2 text-muted">
                {t.text}
                <span class="km" lang="km">{t.textKm}</span>
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- WHAT WE CAN LEARN -->
    <section class="bg-white">
      <div class="mx-auto grid max-w-6xl gap-12 px-4 py-20 sm:px-6 sm:py-28 lg:grid-cols-[1fr_1.4fr]">
        <div>
          <p class="font-semibold text-brand">For young players <span lang="km" class="font-khmer font-normal">· សម្រាប់កីឡាករវ័យក្មេង</span></p>
          <h2 class="mt-2 font-display text-4xl font-extrabold tracking-tight sm:text-5xl">What we can learn from him</h2>
          <p class="km mt-3 text-xl font-semibold sm:text-2xl" lang="km">អ្វីដែលយើងអាចរៀនពីគាត់</p>
        </div>
        <ul class="grid gap-4">
          {
            lessons.map((l) => (
              <li class="flex gap-4 rounded-2xl bg-paper p-6">
                <span class="text-3xl">{l.icon}</span>
                <div>
                  <h3 class="font-display text-lg font-bold">
                    {l.title}
                    <span class="km text-base" lang="km">{l.titleKm}</span>
                  </h3>
                  <p class="mt-1 text-muted">
                    {l.text}
                    <span class="km" lang="km">{l.textKm}</span>
                  </p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- JOIN THE FANS -->
    <section id="join" class="scroll-mt-20 px-4 py-20 sm:px-6">
      <div class="mx-auto max-w-6xl rounded-3xl bg-brand px-6 py-16 text-center text-paper sm:py-20">
        <h2 class="font-display text-4xl font-extrabold tracking-tight text-balance sm:text-5xl">Are you a Ronaldo fan too?</h2>
        <p class="km mt-3 text-xl font-semibold sm:text-2xl" lang="km">តើអ្នកក៏ជាអ្នកគាំទ្ររ៉ូណាល់ដូដែរឬទេ?</p>
        <p class="mx-auto mt-4 max-w-xl text-lg text-paper/85">
          Send us your favorite Ronaldo goal or a photo of your “Siuuu”. We’ll share the best ones here.
          <span class="km" lang="km">ផ្ញើគ្រាប់បាល់របស់រ៉ូណាល់ដូដែលអ្នកចូលចិត្តបំផុត ឬរូបថត “Siuuu” របស់អ្នកមកយើង។ យើងនឹងចែករំលែករូបល្អៗនៅទីនេះ។</span>
        </p>
